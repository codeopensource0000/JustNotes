<?xml version="1.0" encoding="utf-8"?><!--
   Backup rules for devices below API 31 (newer ones read
   data_extraction_rules.xml instead).

   Backup is already switched off outright by android:allowBackup="false"
   in the manifest; these exclusions exist so that nothing here is eligible
   even if that attribute is ever flipped back on. Every domain the app
   actually writes to is listed explicitly rather than relying on "root"
   alone, so the intent stays readable:
     - database   the notes and folders themselves
     - sharedpref PIN salts/hashes (primary + one file per locked note)
                  and the app's settings
     - file       the unpacked Vosk speech models
-->
<full-backup-content>
    <exclude domain="root" path="." />
    <exclude domain="database" path="." />
    <exclude domain="sharedpref" path="." />
    <exclude domain="file" path="." />
    <exclude domain="external" path="." />
</full-backup-content>

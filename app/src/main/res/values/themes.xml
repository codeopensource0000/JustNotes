<?xml version="1.0" encoding="utf-8"?>
<resources>
    <!-- Only the window the system draws before Compose takes over. The app's
         real palette lives in ui/theme/. windowBackground matters because the
         starting window used to be hardcoded light: opening the app in dark
         mode flashed white every single time. -->
    <style name="Theme.JustNotes" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:windowBackground">@color/window_background</item>
    </style>
</resources>
